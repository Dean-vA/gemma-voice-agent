# ---- Backend selection -------------------------------------------------------
# vllm        -> gateway proxies to the vllm OpenAI server (fast, low TTFT)
# transformers-> gateway loads the model in-process (reference / fallback)
BACKEND=vllm

# ---- Model ids ---------------------------------------------------------------
# Full-precision / bnb4 base checkpoint (used by the transformers backend)
MODEL_ID=google/gemma-4-E4B-it
# QAT w4a16 compressed-tensors checkpoint (used by vLLM; confirm exact id)
QAT_MODEL_ID=google/gemma-4-E4B-it-qat-w4a16-ct

# QUANT_MODE applies to the transformers backend: qat | bnb4 | bf16
# (vLLM quantization is configured via its own command flags in compose)
QUANT_MODE=bnb4

# ---- vLLM connection ---------------------------------------------------------
# Inside docker-compose the vllm service is reachable at this URL.
VLLM_BASE_URL=http://vllm:8001/v1

# ---- TTS (voice loop) --------------------------------------------------------
# One engine per container, chosen at build time. Rebuild the tts service after
# changing this:  docker compose build tts
# Options: kokoro (fast default) | piper (CPU/edge) | xtts (expressive/cloning) | chatterbox
TTS_ENGINE=kokoro
TTS_BASE_URL=http://tts:8200

# ---- Audio -------------------------------------------------------------------
SAMPLE_RATE=16000
MAX_AUDIO_SECONDS=30

# ---- Conversation ------------------------------------------------------------
MAX_HISTORY_TURNS=8
MAX_NEW_TOKENS=256
SYSTEM_PROMPT=You are a friendly humanoid robot assistant. Reply in short, natural spoken sentences. Be concise and conversational.

# ---- Server ------------------------------------------------------------------
PORT=8000

# ---- Hugging Face (Gemma repos are gated: accept the license + provide a token)
HF_TOKEN=
